# Copy to .env and fill in. NEVER commit the real .env.
# Get a fresh token from @BotFather (/newbot or /revoke).
BOT_TOKEN=put-your-fresh-botfather-token-here
BOT_USERNAME=your_bot_username

# Database
DB_NAME=vinted
DB_USER=vinted
DB_PASSWORD=change-me

# Optional HTTP/SOCKS proxy for scaling, e.g. http://user:pass@host:port
VINTED_PROXY=
