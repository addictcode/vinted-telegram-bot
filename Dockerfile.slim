# Lightweight image WITHOUT Chrome — pure-HTTP (Jsoup) parsing only.
# Ideal for tiny free hosts (Fly.io / Koyeb / Railway). ~200 MB, runs in 256 MB RAM.
# Selenium fallback is disabled; if a datacenter IP gets challenged, set VINTED_PROXY.

# ---- Build stage ----
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q dependency:go-offline
COPY src ./src
RUN mvn -q clean package -DskipTests

# ---- Runtime stage ----
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

ENV SELENIUM_ENABLED=false \
    IMAGE_CACHE_DIR=/tmp/vinted_images \
    JAVA_OPTS="-XX:MaxRAMPercentage=50 -XX:InitialRAMPercentage=25 -XX:MaxMetaspaceSize=128m -XX:+ExitOnOutOfMemoryError"

# Run as an unprivileged user: a compromised dependency shouldn't get root in the container.
RUN useradd --system --uid 10001 --home-dir /app app && mkdir -p /app/logs && chown -R app /app
COPY --from=build --chown=app /app/target/vinted-telegram-bot-*.jar app.jar
USER app
STOPSIGNAL SIGTERM
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
